{
  "name": "@zensoftwarenl/backstage-plugin-agile-analytics-backend",
  "version": "2.0.0",
  "description": "Backend for the Agile Analytics Backstage plugin. Holds the Agile Analytics API key and proxies the API for the frontend plugin",
  "license": "Apache-2.0",
  "author": "ZEN Software <info@zensoftware.nl>",
  "homepage": "https://github.com/zensoftwarenl/backstage-plugin-agile-analytics#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zensoftwarenl/backstage-plugin-agile-analytics.git",
    "directory": "plugins/agile-analytics-backend"
  },
  "bugs": {
    "url": "https://github.com/zensoftwarenl/backstage-plugin-agile-analytics/issues"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "agile-analytics",
    "dora",
    "slo",
    "error-budget",
    "engineering-metrics"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "agile-analytics",
    "pluginPackages": [
      "@zensoftwarenl/backstage-plugin-agile-analytics",
      "@zensoftwarenl/backstage-plugin-agile-analytics-backend",
      "@zensoftwarenl/backstage-plugin-agile-analytics-common"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-defaults": "^0.18.1",
    "@backstage/backend-plugin-api": "^1.11.0",
    "@backstage/errors": "^1.3.2",
    "@backstage/types": "^1.2.2",
    "@zensoftwarenl/backstage-plugin-agile-analytics-common": "^2.0.0",
    "express": "^4.14.0",
    "express-promise-router": "^4.1.0"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.8",
    "@backstage/cli": "^0.36.7",
    "@types/express": "^4.17.6",
    "@types/supertest": "^2.0.12",
    "supertest": "^6.2.4"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts"
}
