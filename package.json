{
  "name": "root",
  "version": "2.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "tsc": "tsc",
    "build": "backstage-cli repo build --all",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "fix": "backstage-cli repo fix",
    "check:zen": "node scripts/check-no-zen.js",
    "pack:check": "node scripts/check-pack.js",
    "changeset": "changeset",
    "version-packages": "changeset version && yarn install"
  },
  "workspaces": {
    "packages": [
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/cli-defaults": "^0.1.7",
    "@changesets/cli": "^2.27.0",
    "@jest/environment-jsdom-abstract": "^30.5.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.0",
    "jsdom": "^27.1.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "packageManager": "yarn@1.22.22"
}
