{
  "_comment": "Renames applied to every in-tree file before it is merged into this repo, in order. See AGENTS.md. 'files' limits a rule to paths ending in one of them; 'regex' rules use JavaScript RegExp syntax with the g flag.",
  "rules": [
    {
      "from": "@internal/backstage-plugin-agile-analytics",
      "to": "@zensoftwarenl/backstage-plugin-agile-analytics"
    },
    {
      "from": "e.g. `zensoftwarenl/agile`",
      "to": "e.g. `acme/agile`",
      "files": ["src/format.ts"]
    },
    {
      "from": "([^a-z])zen/",
      "to": "$1acme/",
      "regex": true,
      "files": [".test.ts", ".test.tsx"]
    },
    {
      "from": "Zen/API",
      "to": "Acme/API",
      "files": [".test.ts"]
    },
    {
      "from": "'Zen Software'",
      "to": "'Acme Robotics'",
      "files": [".test.ts", ".test.tsx"]
    },
    {
      "from": "'Zen'",
      "to": "'Acme'",
      "files": [".test.ts", ".test.tsx"]
    },
    {
      "from": "ZEN-1",
      "to": "ACME-1",
      "files": [".test.ts", ".test.tsx"]
    },
    {
      "from": "`ZEN-${i}`",
      "to": "`ACME-${i}`",
      "files": [".test.ts"]
    },
    {
